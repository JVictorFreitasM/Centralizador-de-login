DATABASE_URL="postgresql://idp:idp@localhost:5435/idp?schema=public"
NODE_ENV=development
PORT=3000
# Gere um valor proprio por ambiente, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-valor

# OS 03 - OAuth2 Authorization Code
JWT_ISSUER=idp-centralizador-login
# Gere o par com "npm run generate:keys" - a privada nunca e versionada.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_TTL_SECONDS=900
AUTHORIZATION_CODE_TTL_SECONDS=60
# OS 04 - refresh token com rotacao (30 dias)
REFRESH_TOKEN_TTL_SECONDS=2592000
IDP_LOGIN_URL=/login-ui
IDP_PASSWORD_CHANGE_URL=/change-password-ui
